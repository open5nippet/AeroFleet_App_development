# ==============================================================================
# AeroFleet App Development - Global Git Ignore
# This file governs version control rules for the entire repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flutter / Dart
# ------------------------------------------------------------------------------
# Ignore Dart tool folders and packages directories
**/aerobot/.dart_tool/
**/aerobot/.packages
**/aerobot/.pub/
**/aerobot/.pub-cache/

# Ignore build directories and code coverage reports
**/aerobot/build/
**/aerobot/coverage/

# Ignore Flutter-specific generated plugin files
**/aerobot/.flutter-plugins
**/aerobot/.flutter-plugins-dependencies

# ------------------------------------------------------------------------------
# IDE & Editors
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA settings
.idea/
**/aerobot/.idea/
*.iml
**/aerobot/*.iml

# VS Code settings
.vscode/
**/aerobot/.vscode/

# ------------------------------------------------------------------------------
# Operating System
# ------------------------------------------------------------------------------
# macOS system files
.DS_Store
**/.DS_Store

# Windows system files
Thumbs.db
**/Thumbs.db

# ------------------------------------------------------------------------------
# Logs
# ------------------------------------------------------------------------------
# Ignore all log files
*.log
**/*.log

# ------------------------------------------------------------------------------
# Build Artifacts
# ------------------------------------------------------------------------------
# Ignore compiled binaries/packages
*.apk
*.aab
*.ipa
**/*.apk
**/*.aab
**/*.ipa

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
# Ignore Gradle caches and local config
**/aerobot/android/.gradle/
**/aerobot/android/local.properties
**/aerobot/android/key.properties

# Ignore Android signing keystore files
*.jks
*.keystore
**/*.jks
**/*.keystore

# ------------------------------------------------------------------------------
# iOS
# ------------------------------------------------------------------------------
# Ignore CocoaPods dependency files
**/aerobot/ios/Pods/
**/aerobot/ios/.symlinks/

# Ignore iOS build frameworks and generated configurations
**/aerobot/ios/Flutter/Flutter.framework
**/aerobot/ios/Flutter/Flutter.podspec
**/aerobot/ios/Flutter/Generated.xcconfig

# ------------------------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------------------------
# Ignore local environment variable files
.env
.env.*
*.env
**/aerobot/.env
**/aerobot/.env.*
**/aerobot/*.env

# ------------------------------------------------------------------------------
# Firebase Configuration
# ------------------------------------------------------------------------------
# Ignore Firebase configuration files containing API keys and project settings
**/aerobot/android/app/google-services.json
**/aerobot/ios/Runner/GoogleService-Info.plist

# ------------------------------------------------------------------------------
# Temporary Files
# ------------------------------------------------------------------------------
# Ignore general temporary and backup files
*.tmp
*.temp
**/*.tmp
**/*.temp

# ==============================================================================
# Explicit Rules (Do Not Ignore)
# ==============================================================================
# The following files and directories are critical for the application and MUST 
# be committed to ensure clean building and tracking.
!**/aerobot/lib/
!**/aerobot/assets/
!**/aerobot/pubspec.yaml
!**/aerobot/pubspec.lock
!**/aerobot/README.md
!**/aerobot/docs/
!**/aerobot/analysis_options.yaml
